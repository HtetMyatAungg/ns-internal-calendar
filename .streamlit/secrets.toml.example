# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Community Cloud, paste the same content into the app's "Secrets" panel.
# NEVER commit secrets.toml to git.

[app]
org_name = "NS"
# These emails are created as admins automatically on startup. Admins add everyone else
# from the "Members (admin)" page inside the app.
admin_emails = ["you@yourorg.onmicrosoft.com"]
# Timezone used to convert imported iCal feeds (optional, default Europe/London).
timezone = "Europe/London"

[database]
# Local development (see dev_db/):
url = "postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable"
# Production (Neon / Supabase / any PostgreSQL) - example:
# url = "postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
